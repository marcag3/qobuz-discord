# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Restrict slash command registration to one guild (recommended for dev)
# GUILD_ID=

# Discord user ID(s) allowed to run /qobuz-auth and receive Qobuz alerts (comma-separated).
# Defaults to the application owner (or team admins/developers) from the Developer Portal.
# OWNER_ID=

# Qobuz — single shared account
# Browser token (see README). Optional: the bot owner can also set it later with /qobuz-auth.
QOBUZ_USER_TOKEN=

# Where /qobuz-auth saves credentials (overrides the QOBUZ_* values above while present).
# Mount a volume here in Docker so it survives restarts.
# QOBUZ_CREDENTIALS_PATH=data/qobuz-credentials.json

# Alternative: email/password login (implement in bot if token flow is too annoying)
# QOBUZ_EMAIL=
# QOBUZ_PASSWORD=

# Optional: pin an app_id/app_secret pair for stream URL signing. If Qobuz rejects the pinned
# secret, the bot falls back to secrets derived from the web player bundle.
# QOBUZ_APP_ID=
# QOBUZ_APP_SECRET=

# Optional: path to ffmpeg binary (default: ffmpeg on PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Optional: Ohdio live region (8 = Montréal). Catch-up URLs work without this.
# OHDIO_REGION_ID=8

# v2 web login (not implemented yet)
# AUTH_BASE_URL=https://bot.example.com
# ENCRYPTION_KEY=
