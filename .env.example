# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Restrict slash command registration to one guild (recommended for dev)
# GUILD_ID=

# Qobuz — single shared account
# Preferred for spikes + v1: browser token (see docs/SPIKES.md)
QOBUZ_USER_TOKEN=

# Alternative: email/password login (implement in bot if token flow is too annoying)
# QOBUZ_EMAIL=
# QOBUZ_PASSWORD=

# Optional: only if using matched pair from play.qobuz.com devtools (stream URL signing)
# QOBUZ_APP_ID=
# QOBUZ_APP_SECRET=

# v2 web login (not implemented yet)
# AUTH_BASE_URL=https://bot.example.com
# ENCRYPTION_KEY=
