{
  "name": "qobuz-discord",
  "version": "1.0.0",
  "description": "Private Discord bot that streams from a single premium Qobuz account",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src tests"
  },
  "engines": {
    "node": ">=26"
  },
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@kud/qobuz": "^0.5.5",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.5"
  }
}
